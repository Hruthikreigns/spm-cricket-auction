{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug the API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "DATABASE_URL": "sqlite:///./auction.db",
        "JWT_SECRET": "local-dev-secret",
        "ADMIN_EMAIL": "admin@cricauction.com",
        "ADMIN_PASSWORD": "admin123",
        "DEBUG": "true"
      },
      "jinja": false,
      "justMyCode": false
    },
    {
      "name": "Debug the web app (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Run everything",
      "configurations": ["Debug the API", "Debug the web app (Chrome)"],
      "preLaunchTask": "Web",
      "stopAll": true
    }
  ]
}
