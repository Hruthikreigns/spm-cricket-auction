ENVIRONMENT=development
DEBUG=true
# Local development: a file on disk, nothing to install.
DATABASE_URL=sqlite:///./auction.db
# Production: point at PostgreSQL instead.
# DATABASE_URL=postgresql+psycopg://auction:auction@localhost:5432/cricket_auction
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@cricauction.com
ADMIN_PASSWORD=admin123
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173
DEFAULT_PURSE=100000
DEFAULT_MIN_PLAYERS=15
DEFAULT_MAX_PLAYERS=18
DEFAULT_RETAIN_PRICE=3000
DEFAULT_BASE_PRICE=1000
DEFAULT_BID_INCREMENT=500
DEFAULT_TIMER_SECONDS=30

# --- Email, for "forgot password" links ---
# Leave blank and the reset link is written to the server log instead, which
# still works — you read it out of `docker compose logs api`.
# Gmail: use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=you@gmail.com

# Where the emailed link points. Set this to your domain in production.
APP_BASE_URL=http://localhost:5173
RESET_TOKEN_MINUTES=30
